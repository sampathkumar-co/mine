DIRECTOR_ENVIRONMENT=production
DIRECTOR_API_V1_PREFIX=/api/v1
DIRECTOR_PUBLIC_APP_URL=https://director.example.test
DIRECTOR_DOMAIN=director.example.test
DIRECTOR_CORS_ORIGINS=https://director.example.test
DIRECTOR_ACME_EMAIL=replace-with-operated-mailbox

DIRECTOR_DATABASE_URL=postgresql+psycopg://director_release:replace-with-strong-password@postgres:5432/director
DIRECTOR_REDIS_URL=redis://redis:6379/0
DIRECTOR_UPLOAD_DIR=/data/uploads
DIRECTOR_OUTPUT_DIR=/data/outputs
DIRECTOR_OBJECT_STORAGE_LOCAL_DIR=/data/object-storage
DIRECTOR_AUTO_CREATE_SCHEMA=false
DIRECTOR_RUN_MIGRATIONS_ON_STARTUP=false

DIRECTOR_AUTH_REQUIRED=true
DIRECTOR_AUTH_SECRET=replace-with-at-least-32-random-characters
DIRECTOR_REQUIRE_VERIFIED_EMAIL=true
DIRECTOR_ACCESS_TOKEN_MINUTES=15
DIRECTOR_REFRESH_TOKEN_DAYS=30
DIRECTOR_DELIVERY_LINK_MINUTES=20

DIRECTOR_RATE_LIMIT_ENABLED=true
DIRECTOR_RATE_LIMIT_BACKEND=redis
DIRECTOR_RATE_LIMIT_FAIL_CLOSED=true
DIRECTOR_RATE_LIMIT_WINDOW_SECONDS=60
DIRECTOR_TRUST_PROXY_HEADERS=true
DIRECTOR_READINESS_REQUIRE_REDIS=true
DIRECTOR_METRICS_ENABLED=true
DIRECTOR_METRICS_TOKEN=replace-with-random-metrics-token
DIRECTOR_LOG_FORMAT=json
DIRECTOR_LOG_LEVEL=INFO

DIRECTOR_EMAIL_PROVIDER=smtp
DIRECTOR_SMTP_HOST=replace-with-smtp-host
DIRECTOR_SMTP_PORT=587
DIRECTOR_SMTP_STARTTLS=true
DIRECTOR_SMTP_USERNAME=replace-with-smtp-user
DIRECTOR_SMTP_PASSWORD=replace-with-smtp-password
DIRECTOR_SMTP_FROM_EMAIL=replace-with-sender-address

DIRECTOR_OBJECT_STORAGE_PROVIDER=s3
DIRECTOR_S3_BUCKET=replace-with-bucket
DIRECTOR_S3_REGION=replace-with-region
DIRECTOR_S3_ENDPOINT_URL=
DIRECTOR_S3_ACCESS_KEY_ID=replace-with-access-key-or-use-workload-identity
DIRECTOR_S3_SECRET_ACCESS_KEY=replace-with-secret-key-or-use-workload-identity
DIRECTOR_MULTIPART_PART_BYTES=8388608
DIRECTOR_MULTIPART_PRESIGN_MINUTES=15

DIRECTOR_BILLING_ENABLED=true
DIRECTOR_ENTITLEMENTS_ENABLED=true
DIRECTOR_SUBSCRIPTIONS_ENABLED=true
DIRECTOR_BILLING_PROVIDER=stripe
DIRECTOR_BILLING_PLANS_JSON={"starter":{"name":"Starter","description":"Core autonomous production for small teams.","price_id":null,"monthly_credits":0,"max_source_clips":8,"max_target_duration_seconds":180,"max_members":3,"max_tier":1},"creator":{"name":"Creator","description":"Longer productions, more sources, and advanced Director tiers.","price_id":"price_creator_replace","monthly_credits":250,"max_source_clips":16,"max_target_duration_seconds":600,"max_members":8,"max_tier":3},"studio":{"name":"Studio","description":"High-volume production and full Director capabilities.","price_id":"price_studio_replace","monthly_credits":1200,"max_source_clips":24,"max_target_duration_seconds":1800,"max_members":25,"max_tier":6}}
DIRECTOR_STRIPE_SECRET_KEY=replace-with-stripe-secret
DIRECTOR_STRIPE_WEBHOOK_SECRET=replace-with-stripe-webhook-secret
DIRECTOR_STRIPE_PORTAL_CONFIGURATION_ID=replace-with-portal-configuration

DIRECTOR_TRANSCRIPTION_PROVIDER=openai
DIRECTOR_REQUIRE_TRANSCRIPTION=true
DIRECTOR_OPENAI_API_KEY=replace-with-provider-key
DIRECTOR_TRANSCRIPTION_MODEL=whisper-1
DIRECTOR_OPENAI_BASE_URL=https://api.openai.com/v1

DIRECTOR_BACKUP_DIR=/mnt/encrypted-off-host-backups/director-os
DIRECTOR_BACKUP_RETENTION_DAYS=14
DIRECTOR_POSTGRES_CONTAINER=postgres
DIRECTOR_POSTGRES_DATABASE=director
DIRECTOR_POSTGRES_USER=director_release
