DIRECTOR_ENVIRONMENT=development
DIRECTOR_API_V1_PREFIX=/api/v1
DIRECTOR_PUBLIC_APP_URL=http://localhost:3000
DIRECTOR_DATABASE_URL=postgresql+psycopg://director:director@postgres:5432/director
DIRECTOR_REDIS_URL=redis://redis:6379/0
DIRECTOR_UPLOAD_DIR=/data/uploads
DIRECTOR_OUTPUT_DIR=/data/outputs
DIRECTOR_MAX_UPLOAD_BYTES=2147483648
DIRECTOR_UPLOAD_CHUNK_BYTES=1048576
DIRECTOR_RESUMABLE_REQUEST_BYTES=16777216
DIRECTOR_UPLOAD_SESSION_HOURS=24

DIRECTOR_AUTH_REQUIRED=true
DIRECTOR_AUTH_SECRET=replace-with-at-least-32-random-characters
DIRECTOR_ACCESS_TOKEN_MINUTES=15
DIRECTOR_REFRESH_TOKEN_DAYS=30
DIRECTOR_REQUIRE_VERIFIED_EMAIL=false
DIRECTOR_EMAIL_VERIFICATION_MINUTES=1440
DIRECTOR_PASSWORD_RESET_MINUTES=60
DIRECTOR_INVITATION_DAYS=7
DIRECTOR_DELIVERY_LINK_MINUTES=20

DIRECTOR_EMAIL_PROVIDER=database
DIRECTOR_SMTP_HOST=
DIRECTOR_SMTP_PORT=587
DIRECTOR_SMTP_STARTTLS=true
DIRECTOR_SMTP_USERNAME=
DIRECTOR_SMTP_PASSWORD=
DIRECTOR_SMTP_FROM_EMAIL=

DIRECTOR_OBJECT_STORAGE_PROVIDER=local
DIRECTOR_OBJECT_STORAGE_LOCAL_DIR=/data/object-storage
DIRECTOR_MULTIPART_PART_BYTES=8388608
DIRECTOR_MULTIPART_PRESIGN_MINUTES=15
DIRECTOR_S3_BUCKET=
DIRECTOR_S3_REGION=us-east-1
DIRECTOR_S3_ENDPOINT_URL=
DIRECTOR_S3_ACCESS_KEY_ID=
DIRECTOR_S3_SECRET_ACCESS_KEY=

DIRECTOR_STARTER_CREDITS=100
DIRECTOR_BILLING_ENABLED=true
DIRECTOR_ENTITLEMENTS_ENABLED=true
DIRECTOR_SUBSCRIPTIONS_ENABLED=false
DIRECTOR_BILLING_PROVIDER=stripe
DIRECTOR_BILLING_PLANS_JSON={"starter":{"name":"Starter","description":"Core autonomous production for small teams.","price_id":null,"monthly_credits":0,"max_source_clips":8,"max_target_duration_seconds":180,"max_members":3,"max_tier":1},"creator":{"name":"Creator","description":"Longer productions, more sources, and advanced Director tiers.","price_id":"price_creator_replace","monthly_credits":250,"max_source_clips":16,"max_target_duration_seconds":600,"max_members":8,"max_tier":3},"studio":{"name":"Studio","description":"High-volume production and full Director capabilities.","price_id":"price_studio_replace","monthly_credits":1200,"max_source_clips":24,"max_target_duration_seconds":1800,"max_members":25,"max_tier":6}}
DIRECTOR_STRIPE_SECRET_KEY=
DIRECTOR_STRIPE_WEBHOOK_SECRET=
DIRECTOR_STRIPE_PORTAL_CONFIGURATION_ID=
DIRECTOR_AUDIT_RETENTION_DAYS=365
DIRECTOR_RUN_MIGRATIONS_ON_STARTUP=false
DIRECTOR_AUTO_CREATE_SCHEMA=true

DIRECTOR_RENDER_TIMEOUT_SECONDS=3600
DIRECTOR_FFMPEG_BINARY=ffmpeg
DIRECTOR_FFPROBE_BINARY=ffprobe
DIRECTOR_SCENE_DETECTION_THRESHOLD=0.35
DIRECTOR_MINIMUM_SCENE_SECONDS=0.5
DIRECTOR_TRANSCRIPTION_PROVIDER=openai
DIRECTOR_TRANSCRIPTION_MODEL=whisper-1
DIRECTOR_TRANSCRIPTION_TIMEOUT_SECONDS=600
DIRECTOR_REQUIRE_TRANSCRIPTION=false
DIRECTOR_OPENAI_API_KEY=
DIRECTOR_OPENAI_BASE_URL=https://api.openai.com/v1
DIRECTOR_ENABLE_WORD_CLEANUP=true
DIRECTOR_SILENCE_THRESHOLD_SECONDS=0.55
DIRECTOR_SPEECH_PADDING_SECONDS=0.08
DIRECTOR_ENABLE_CAPTIONS=true
DIRECTOR_CAPTION_MAX_WORDS=5
DIRECTOR_CAPTION_MARGIN_VERTICAL=260
DIRECTOR_ENABLE_SUBJECT_FRAMING=true
DIRECTOR_SUBJECT_FRAME_SAMPLES=24
DIRECTOR_ENABLE_REFERENCE_STYLE=true
DIRECTOR_REFERENCE_FRAME_SAMPLES=24
DIRECTOR_ENABLE_MUSIC=true
DIRECTOR_MUSIC_DEFAULT_VOLUME=0.16
DIRECTOR_MUSIC_DUCKING_THRESHOLD=0.035
DIRECTOR_MUSIC_FADE_SECONDS=0.8
DIRECTOR_MAX_SOURCE_CLIPS=8
DIRECTOR_DUPLICATE_HASH_DISTANCE=6
DIRECTOR_ENABLE_SEMANTIC_OVERLAYS=true
DIRECTOR_SEMANTIC_FRAME_SAMPLES=10
DIRECTOR_MAX_VISUAL_OVERLAYS=4
DIRECTOR_MINIMUM_OVERLAY_MATCH_SCORE=0.30
DIRECTOR_REQUIRE_EDITORIAL_CRITIC_PASS=true
DIRECTOR_CORS_ORIGINS=http://localhost:3000
DIRECTOR_DOMAIN=localhost
DIRECTOR_ACME_EMAIL=admin@example.com
