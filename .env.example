DIRECTOR_ENVIRONMENT=development
DIRECTOR_API_V1_PREFIX=/api/v1
DIRECTOR_DATABASE_URL=postgresql+psycopg://director:director@postgres:5432/director
DIRECTOR_REDIS_URL=redis://redis:6379/0
DIRECTOR_UPLOAD_DIR=/data/uploads
DIRECTOR_OUTPUT_DIR=/data/outputs
DIRECTOR_MAX_UPLOAD_BYTES=2147483648
DIRECTOR_UPLOAD_CHUNK_BYTES=1048576
DIRECTOR_RENDER_TIMEOUT_SECONDS=3600
DIRECTOR_FFMPEG_BINARY=ffmpeg
DIRECTOR_FFPROBE_BINARY=ffprobe
DIRECTOR_SCENE_DETECTION_THRESHOLD=0.35
DIRECTOR_MINIMUM_SCENE_SECONDS=0.5
DIRECTOR_TRANSCRIPTION_PROVIDER=openai
DIRECTOR_TRANSCRIPTION_MODEL=whisper-1
DIRECTOR_TRANSCRIPTION_TIMEOUT_SECONDS=600
DIRECTOR_REQUIRE_TRANSCRIPTION=false
DIRECTOR_OPENAI_API_KEY=
DIRECTOR_OPENAI_BASE_URL=https://api.openai.com/v1
DIRECTOR_AUTO_CREATE_SCHEMA=true
DIRECTOR_CORS_ORIGINS=http://localhost:3000
